// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel GenHiz

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float> _destinateMap;
Texture2D<float4> _resourceMap; //RWTexture2D 对应某一级视图  不能读取任意mip
int _mip;
int _mapSize;

[numthreads(8,8,1)]
void GenHiz (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=_mapSize || id.y>=_mapSize){
        return;
    }
    int2 srcuv = id.xy*2; //各两格才采样原始贴图
    // TODO: insert actual code here!
    float a = _resourceMap.Load(float3(srcuv+int2(0,0),_mip)).x;
    float b = _resourceMap.Load(float3(srcuv+int2(1,0),_mip)).x;
    float c = _resourceMap.Load(float3(srcuv+int2(0,1),_mip)).x;
    float d = _resourceMap.Load(float3(srcuv+int2(1,1),_mip)).x;

    float nearestDepth = max(max(a,b),max(c,d));
    _destinateMap[id.xy] = nearestDepth;
    
}
