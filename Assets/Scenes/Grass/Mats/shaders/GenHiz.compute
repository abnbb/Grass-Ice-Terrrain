// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel GenHiz

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float> _destinateMap;
RWTexture2D<float> _resourceMap; //RWTexture2D 
int _mip;
int _mapSize;

[numthreads(8,8,1)]
void GenHiz (uint3 id : SV_DispatchThreadID)
{
    if(id.x>=_mapSize || id.y>=_mapSize){
        return;
    }
    int2 srcuv = id.xy*2; //各两格才采样原始贴图
    // int2 srcuv = id.xy;
    // TODO: insert actual code here!
    float a = _resourceMap.Load(int3(srcuv+int2(0,0),0)).x;
    float b = _resourceMap.Load(int3(srcuv+int2(1,0),0)).x;
    float c = _resourceMap.Load(int3(srcuv+int2(0,1),0)).x;
    float d = _resourceMap.Load(int3(srcuv+int2(1,1),0)).x;
    
    
    float nearestDepth = max(max(a,b),max(c,d));
    
    // float a = _resourceMap.Load(float3(srcuv,1)).x;
    
    _destinateMap[id.xy] = a;
    
}
